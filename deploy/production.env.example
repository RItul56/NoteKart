# Copy this file to .env.production in the project root. Never commit it.
POSTGRES_USER=notekart
POSTGRES_DB=notekart
# Use lowercase/uppercase letters and digits only; generate a random 64-character hex value.
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-secret
# Generate a separate random 64-character hex value. Do not reuse the DB password.
SESSION_SECRET=replace-with-a-different-random-64-character-hex-secret
# Exact public HTTPS origin, with no path or trailing slash.
APP_ORIGIN=https://notekart.example.com
MAX_UPLOAD_MB=15

# Leave SMTP_PASSWORD blank until the sending account's SMTP credential is configured.
# For Gmail, use an app password; never use the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ritulmastkar56@gmail.com
SMTP_PASSWORD=
NOTEKART_EMAIL=ritulmastkar56@gmail.com

# Optional. Leave blank to disable online checkout until credentials are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
